# Origin of the Chitra AI Django API. No trailing slash.
#
# Local development:
VITE_API_BASE_URL=http://localhost:8000
#
# Production: set this in the Vercel project's environment variables, NOT here.
# The GitHub Actions deploy runs `vercel pull`, which fetches it from Vercel.
# VITE_API_BASE_URL=https://chitra-ai.devtechguru.cloud

# --- Demo account (optional) ----------------------------------------------
# When both are set, the sign-in screen shows a panel with these credentials
# and a one-click "Use demo account" button. Leave either blank to hide it.
#
# These are compiled into the public client bundle, so the account they name
# must be an ordinary, powerless user. Create it on the server with:
#   python manage.py create_demo_user --email <email> --password <password>
#
# IMPORTANT: in Vercel these must be stored as NON-SENSITIVE. `vercel env pull`
# returns the literal "[SENSITIVE]" for sensitive variables, which would bake
# a broken value into the bundle.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
