# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DJANGO_ALLOWED_HOSTS=chitra-ai.devtechguru.cloud

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/chitra_ai

# --- Hugging Face ---------------------------------------------------------
# Create at https://huggingface.co/settings/tokens (a read token is enough).
# NEVER commit the real value and never expose it to the React client.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=black-forest-labs/FLUX.1-schnell
HF_PROVIDER=auto
HF_TIMEOUT=120

# --- Frontend origin ------------------------------------------------------
# Exact scheme + host, no trailing slash, comma separated.
# This is a SECURITY CONTROL, not just convenience: the cookie-authenticated
# refresh and logout endpoints validate the request Origin against this list.
# Never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production: CORS_ALLOWED_ORIGINS=https://chitra-ai.technicalbind.com

# --- Provider / storage selection ----------------------------------------
# IMAGE_PROVIDER: huggingface | stub   (stub generates offline placeholders)
IMAGE_PROVIDER=huggingface
IMAGE_STORAGE=local

# Absolute origin for image URLs, so the Vercel frontend can load them.
# Leave empty in development: dev settings fall back to http://localhost:8000,
# because a relative /media/ URL would resolve against the Vite dev server.
MEDIA_BASE_URL=
# Production: MEDIA_BASE_URL=https://chitra-ai.devtechguru.cloud

# --- Rate limits ----------------------------------------------------------
GENERATION_RATE=20/hour
ANON_RATE=30/hour
USER_RATE=300/hour
